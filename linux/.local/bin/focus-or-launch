#!/usr/bin/env bash

# focus-or-launch CLASS CMD [ARGS...]
# Focus the first window matching CLASS, or launch CMD if none is found.

CLASS="$1"
shift

if hyprctl clients -j 2>/dev/null | grep -qF "\"class\": \"${CLASS}\""; then
    # Keyboard-driven focus alone doesn't restack floating windows in
    # Hyprland, so alterzorder is needed too (see quick_terminal):
    # https://github.com/hyprwm/Hyprland/discussions/5451
    hyprctl dispatch "hl.dsp.focus{window=hl.get_windows({class='${CLASS}'})[1]}"
    hyprctl dispatch "hl.dsp.window.alter_zorder{mode='top', window=hl.get_windows({class='${CLASS}'})[1]}"
else
    runapp "$@"
fi
