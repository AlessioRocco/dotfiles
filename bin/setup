#!/bin/bash

# Dotfiles setup orchestrator (macOS + Linux).
#
# Responsibilities:
#   - Ensure the repo is cloned at ~/dotfiles.
#   - Ensure GNU Stow is installed.
#   - Symlink the shared `common` package into $HOME with Stow.
#   - Detect the OS, symlink the matching package (`macos`/`linux`) and source
#     its OS-specific setup script.
#   - Authenticate GitHub CLI (gh auth login) so HTTPS clones work.
#   - Clone dotfiles-private and run its own setup script.
#   - Run the shared post-install steps (bin/post-install).
#
# Safe to re-run.

fancy_echo() {
  # shellcheck disable=SC2059
  printf "\\n$1\\n"
}

# Add a failed message if setup fails.
# shellcheck disable=SC2154
trap 'ret=$?; test $ret -ne 0 && fancy_echo "Setup failed!" >&2; exit $ret' EXIT

# Exit immediately if a command exits with a non-zero status.
set -e

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/AlessioRocco/dotfiles}"
PRIVATE_DIR="${PRIVATE_DIR:-$HOME/dotfiles-private}"
PRIVATE_REPO="${PRIVATE_REPO:-git@github.com:AlessioRocco/dotfiles-private.git}"

# Clone the repo if it is not already present.
if [ ! -d "$DOTFILES_DIR" ]; then
  fancy_echo "Cloning dotfiles into $DOTFILES_DIR ..."
  git clone "$DOTFILES_REPO" "$DOTFILES_DIR"
fi

OS="$(uname -s)"

# Ensure GNU Stow is available (needed before we can stow anything).
ensure_stow() {
  if command -v stow >/dev/null 2>&1; then
    return
  fi

  fancy_echo "Installing GNU Stow ..."
  case "$OS" in
  Darwin)
    if [ -x /opt/homebrew/bin/brew ]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    if ! command -v brew >/dev/null 2>&1; then
      fancy_echo "Installing Homebrew ..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    brew install stow
    ;;
  Linux)
    if command -v apt-get >/dev/null 2>&1; then
      sudo apt-get update && sudo apt-get install -y stow
    elif command -v dnf >/dev/null 2>&1; then
      sudo dnf install -y stow
    elif command -v pacman >/dev/null 2>&1; then
      sudo pacman -S --noconfirm stow
    else
      fancy_echo "Could not find a supported package manager to install stow." >&2
      exit 1
    fi
    ;;
  *)
    fancy_echo "Unsupported OS: $OS" >&2
    exit 1
    ;;
  esac
}

ensure_stow

# Stow the shared package.
fancy_echo "Stowing 'common' ..."
stow --dir="$DOTFILES_DIR" --target="$HOME" --no-folding --adopt --restow common

# Stow the OS-specific package and run its setup script.
#   The OS script installs packages (Homebrew bundle, apt, etc.), so it runs
#   before the shared steps below that depend on those tools. It is sourced
#   (not executed) so any environment it sets up (e.g. `brew shellenv`)
#   persists for the shared steps.
case "$OS" in
Darwin)
  fancy_echo "Stowing 'macos' ..."
  stow --dir="$DOTFILES_DIR" --target="$HOME" --no-folding --adopt --restow macos
  . "$DOTFILES_DIR/macos/bin/setup"
  ;;
Linux)
  fancy_echo "Stowing 'linux' ..."
  stow --dir="$DOTFILES_DIR" --target="$HOME" --no-folding --adopt --restow linux
  . "$DOTFILES_DIR/linux/bin/setup"
  ;;
*)
  fancy_echo "Unsupported OS: $OS" >&2
  exit 1
  ;;
esac

# Authenticate GitHub CLI so HTTPS clones (e.g. private skill repos) work.
#   Must run after the OS setup, which installs gh and google-chrome.
#   The git credential helper itself is already wired up declaratively in
#   common/.gitconfig (portable `!gh auth git-credential`, no absolute path)
#   — do NOT run `gh auth setup-git` here, it rewrites that tracked, shared
#   file with this machine's absolute `gh` binary path, which then conflicts
#   with the same lines written on other machines (mac vs Linux paths).
if gh auth status >/dev/null 2>&1; then
  fancy_echo "gh already authenticated."
else
  fancy_echo "Authenticating GitHub CLI (browser will open) ..."
  gh auth login --web
fi

# Clone the private dotfiles and hand over to their own setup script, which
#   owns what happens to them (stow, agent skills). The clone needs an SSH key
#   with access to the repo, so a failure here only warns: the public setup
#   stays usable on a machine where the key is not there yet.
if [ ! -d "$PRIVATE_DIR" ]; then
  fancy_echo "Cloning dotfiles-private into $PRIVATE_DIR ..."
  if ! git clone "$PRIVATE_REPO" "$PRIVATE_DIR"; then
    fancy_echo "Could not clone $PRIVATE_REPO." >&2
    fancy_echo "Add an SSH key with access to it and re-run this script." >&2
  fi
fi

if [ -x "$PRIVATE_DIR/bin/setup" ]; then
  fancy_echo "Running dotfiles-private setup ..."
  "$PRIVATE_DIR/bin/setup"
elif [ -d "$PRIVATE_DIR" ]; then
  fancy_echo "$PRIVATE_DIR has no executable bin/setup; skipping." >&2
fi

# Shared post-install steps.
fancy_echo "Running post-install steps ..."
. "$DOTFILES_DIR/bin/post-install"

fancy_echo 'Setup completed!'
