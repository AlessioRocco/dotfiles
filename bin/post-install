#!/bin/sh

# Shared post-install steps for both macOS and Linux.
# Installs Mise, creates the code folder, and installs editor themes.
# Safe to re-run; sourced by the top-level bin/setup orchestrator.

# Install or update Mise (https://mise.jdx.dev/getting-started.html).
#   On Linux mise comes from the `mise` package (paru, see
#   linux/bin/packages/base.packages) and updates via `paru -Syu`; that build
#   has self-update compiled out, so `mise self-update` errors there. Warn
#   instead of aborting the whole setup over a failed self-update.
if ! command -v mise >/dev/null 2>&1; then
  fancy_echo "Installing Mise ..."
  curl https://mise.run | sh
else
  fancy_echo "Updating Mise ..."
  mise self-update || fancy_echo "mise self-update unavailable (likely a package-manager install); skipping." >&2
fi

# Set up rtk's Claude Code integration (hook, RTK.md, CLAUDE.md reference).
# The hook entry and the @RTK.md line in AGENTS.md are already tracked and
# stowed by dotfiles-private before this runs, so this only needs to write
# the local, untracked RTK.md on a fresh machine; it's a no-op here on
# already-configured machines. Guarded so it no-ops if rtk failed to install
# earlier in setup.
if command -v rtk >/dev/null 2>&1; then
  fancy_echo "Configuring rtk for Claude Code ..."
  rtk init -g --auto-patch
fi

# Create the code folder.
CODE_DIR="$HOME/code"
if [ ! -d "$CODE_DIR" ]; then
  fancy_echo "Creating code folder ..."
  mkdir "$CODE_DIR"
fi

# Clone Alessio's own nvim config (avim) and symlink it into ~/.config.
NVIM_CONFIG_DIR="$HOME/code/AlessioRocco/nvim-config"
if [ ! -d "$NVIM_CONFIG_DIR" ]; then
  fancy_echo "Cloning nvim-config into $NVIM_CONFIG_DIR ..."
  mkdir -p "$HOME/code/AlessioRocco"
  git clone https://github.com/AlessioRocco/nvim-config "$NVIM_CONFIG_DIR"
fi

AVIM_LINK="$HOME/.config/avim"
if [ -L "$AVIM_LINK" ]; then
  if [ "$(readlink "$AVIM_LINK")" != "$NVIM_CONFIG_DIR" ]; then
    fancy_echo "Relinking $AVIM_LINK -> $NVIM_CONFIG_DIR ..."
    rm "$AVIM_LINK"
    ln -s "$NVIM_CONFIG_DIR" "$AVIM_LINK"
  fi
elif [ -e "$AVIM_LINK" ]; then
  fancy_echo "$AVIM_LINK exists and is not a symlink; skipping." >&2
else
  fancy_echo "Linking $AVIM_LINK -> $NVIM_CONFIG_DIR ..."
  ln -s "$NVIM_CONFIG_DIR" "$AVIM_LINK"
fi

# Editor / pager themes (Catppuccin).
fancy_echo 'Installing themes ...'
mkdir -p ~/.config/delta/themes

# Bat
if command -v bat >/dev/null 2>&1; then
  bat cache --build
fi

# Btop
if command -v btop >/dev/null 2>&1; then
  BTOP_CONF="$HOME/.config/btop/btop.conf"
  mkdir -p "$(dirname "$BTOP_CONF")"
  if [ -f "$BTOP_CONF" ]; then
    sed -i 's/^color_theme = .*/color_theme = "catppuccin_macchiato"/' "$BTOP_CONF"
  else
    echo 'color_theme = "catppuccin_macchiato"' > "$BTOP_CONF"
  fi
fi

# Change the default shell to fish if needed.
update_shell() {
  shell_path="$(command -v fish)"

  fancy_echo "Changing your shell to fish ..."
  if ! grep "$shell_path" /etc/shells >/dev/null 2>&1; then
    fancy_echo "Adding '$shell_path' to /etc/shells"
    sudo sh -c "echo $shell_path >> /etc/shells"
  fi
  sudo chsh -s "$shell_path" "$USER"
}

case "$SHELL" in
*/fish)
  if [ "$SHELL" != "$(command -v fish)" ]; then
    update_shell
  fi
  ;;
*)
  update_shell
  ;;
esac

# Install the crontab tracked at common/.config/cron/crontab. This REPLACES
# the whole crontab with that file's contents, so scheduled jobs belong
# there, not added through `crontab -e` — those would be gone on the next
# setup run.
if command -v crontab >/dev/null 2>&1; then
  fancy_echo "Installing crontab ..."
  crontab "$HOME/.config/cron/crontab"
fi

fancy_echo 'Checking theme files against upstream ...'
. "$DOTFILES_DIR/bin/check-themes"

fancy_echo 'Post-install completed!'
