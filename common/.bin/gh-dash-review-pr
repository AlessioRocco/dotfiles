#!/bin/bash
#
# gh-dash "review in worktree" keybinding.
#
# Checks out a PR's branch into its own worktree via worktrunk, then registers
# it with herdr so it shows up as its own workspace in the sidebar instead of
# a bare `cd`. Falls back to a plain `wt switch` outside herdr.

set -euo pipefail

repo_path=$1
pr=$2

cd "$repo_path"

result=$(wt switch "pr:$pr" --no-cd --format=json)
wtpath=$(printf '%s' "$result" | jq -r '.path // empty')
if [[ -z $wtpath ]]; then
  echo "worktrunk returned no worktree path for pr:$pr" >&2
  exit 1
fi

if [[ -z ${HERDR_ENV:-} ]]; then
  echo "$wtpath"
  exit 0
fi

herdr=${HERDR_BIN_PATH:-herdr}

# `worktree open` must run from the repo's root workspace, not a linked
# worktree's own workspace (see the worktrunk herdr plugin's picker.sh for the
# same resolution).
root_ws=$("$herdr" worktree list --cwd "$repo_path" --json | jq -r '.result.source.source_workspace_id // empty')
[[ -z $root_ws ]] && root_ws=$HERDR_WORKSPACE_ID

"$herdr" worktree open --workspace "$root_ws" --path "$wtpath" --label "pr-$pr" --focus --json
