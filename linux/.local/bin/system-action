#!/usr/bin/env bash

SUBCOMMAND="${1-}"
ACTION="${2-}"

usage() {
  cat >&2 <<'EOF'
Usage: system-action <subcommand> <action> [args]

Subcommands:
  volume        up | down | mute
  mic           mute
  brightness    up | down
  idle          toggle
  session       lock | suspend | reboot | shutdown
  notifications clear-active | clear-history | toggle-dnd
  media         previous | toggle | stop | next
  screenshot    region | fullscreen
  screenrecord  start | stop
EOF
  exit 1
}

volume() {
  case "${ACTION}" in
  up)   wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ ;;
  down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  *)    echo "Usage: system-action volume <up|down|mute>" >&2; exit 1 ;;
  esac
}

mic() {
  case "${ACTION}" in
  mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
  *)    echo "Usage: system-action mic <mute>" >&2; exit 1 ;;
  esac
}

brightness() {
  case "${ACTION}" in
  up)   brightnessctl -e4 -n2 set 5%+ ;;
  down) brightnessctl -e4 -n2 set 5%- ;;
  *)    echo "Usage: system-action brightness <up|down>" >&2; exit 1 ;;
  esac
}

idle() {
  case "${ACTION}" in
  toggle) pkill --signal 42 waybar ;;
  *)      echo "Usage: system-action idle <toggle>" >&2; exit 1 ;;
  esac
}

session() {
  case "${ACTION}" in
  lock)     pidof hyprlock || hyprlock ;;
  suspend)  systemctl suspend ;;
  reboot)   hyprshutdown -t 'Restarting...' --post-cmd 'reboot' ;;
  shutdown) hyprshutdown -t 'Shutting down...' --post-cmd 'shutdown -P 0' ;;
  *)        echo "Usage: system-action session <lock|suspend|reboot|shutdown>" >&2; exit 1 ;;
  esac
}

notifications() {
  case "${ACTION}" in
  clear-active)  makoctl dismiss ;;
  clear-history) makoctl dismiss --all ;;
  toggle-dnd)    makoctl mode toggle ;;
  *)             echo "Usage: system-action notifications <clear-active|clear-history|toggle-dnd>" >&2; exit 1 ;;
  esac
}

media() {
  case "${ACTION}" in
  previous) playerctl previous ;;
  toggle)   playerctl play-pause ;;
  stop)     playerctl stop ;;
  next)     playerctl next ;;
  *)        echo "Usage: system-action media <previous|toggle|stop|next>" >&2; exit 1 ;;
  esac
}

screenshot_action() {
  case "${ACTION}" in
  region)     screenshot region ;;
  fullscreen) screenshot fullscreen ;;
  *)          echo "Usage: system-action screenshot <region|fullscreen>" >&2; exit 1 ;;
  esac
}

screenrecord_action() {
  case "${ACTION}" in
  start) screenrecord ;;
  stop)  screenrecord --stop-recording ;;
  *)     echo "Usage: system-action screenrecord <start|stop>" >&2; exit 1 ;;
  esac
}

case "${SUBCOMMAND}" in
volume)       volume ;;
mic)          mic ;;
brightness)   brightness ;;
idle)         idle ;;
session)      session ;;
notifications) notifications ;;
media)        media ;;
screenshot)   screenshot_action ;;
screenrecord) screenrecord_action ;;
*)            usage ;;
esac
