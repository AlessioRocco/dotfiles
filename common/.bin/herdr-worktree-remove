#!/usr/bin/env bash
#
# Remove the worktree you are looking at. Bound to a herdr popup, where there is
# nothing to pick: the workspace already identifies the checkout.
#
# It asks first. `wt remove` doesn't: it refuses dirty checkouts and unmerged
# branches, and considers everything else safe to take, so a keystroke away from
# the workspace would otherwise be a keystroke away from deleting the checkout
# and its branch. lazygit's `d` asks too, via its own confirm prompt.
#
# The removal itself is `wt remove`, the same command lazygit's `d` runs, so a
# worktree goes away identically everywhere: branch deleted when merged,
# worktrunk's hooks run (which is what closes the workspace), the primary
# checkout refused outright. herdr's own `worktree remove` does none of that — it
# strands the branch.

set -uo pipefail

pause() {
  printf '\n\033[31m%s\033[0m press any key to close' "$1"
  read -rn1
  exit 0
}

target=$(herdr-worktree-current)
[[ -z $target ]] && pause "No worktree to remove — $PWD is not in a repository."

branch=$(git -C "$target" branch --show-current 2>/dev/null) || branch=""

printf 'Remove worktree %s (%s)? [y/N] ' "${branch:-detached HEAD}" "${target/#$HOME/~}"
IFS= read -rsn1 answer || answer=""
printf '\n'
[[ $answer == [yY] ]] || exit 0

wt remove --foreground "$target" || pause "wt remove failed (see above)."
