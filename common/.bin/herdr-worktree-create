#!/usr/bin/env bash
#
# Create a worktree branching off the one you are in, asking only for the name.
# Bound to a herdr popup, and deliberately listless: the checkout you came from
# is the base, so there is nothing to pick — the same shape as
# herdr-worktree-remove. Esc backs out, Enter on an empty name does too.
#
# `-C` matters more than it looks: it makes `--base @` resolve to the branch of
# that checkout rather than to whatever branch the popup's working directory
# happens to be on.
#
# Nothing here opens a workspace: worktrunk's post-switch hook does that.

set -uo pipefail

pause() {
  printf '\n\033[31m%s\033[0m press any key to close' "$1"
  read -rn1
  exit 0
}

# Reads a line one key at a time, because `read -r` has no notion of cancelling:
# Esc would just land in the buffer. Sets $name; returns 1 when cancelled.
name=""
read_name() {
  local char rest
  printf '%s' "$1"
  while IFS= read -rsn1 char; do
    case $char in
      $'\e')
        # Arrow keys and mouse reports also start with Esc, so a lone one — no
        # bytes trailing it — is the only one that means "get me out of here".
        if IFS= read -rsn2 -t 0.05 rest; then
          continue
        fi
        printf '\n'
        return 1
        ;;
      '')
        printf '\n'
        return 0
        ;;
      $'\177' | $'\b')
        [[ -n $name ]] && {
          name=${name%?}
          printf '\b \b'
        }
        ;;
      *)
        name+=$char
        printf '%s' "$char"
        ;;
    esac
  done
  printf '\n'
}

from=$(herdr-worktree-current)
[[ -z $from ]] && pause "No checkout to branch from — $PWD is not in a repository."

base=$(git -C "$from" branch --show-current 2>/dev/null) || base=""

read_name "New branch, from ${base:-HEAD} (esc to cancel) ❯ " || exit 0
[[ -z $name ]] && exit 0

wt -C "$from" switch --create --no-cd --base @ "$name" ||
  pause "wt switch failed (see above)."
