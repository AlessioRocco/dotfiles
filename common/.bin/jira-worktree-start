#!/bin/bash
#
# Pick a Jira issue assigned to me and land in a worktree for it — creating
# one, named `arocco/<key>/<slug>`, on day one, or resuming the one already
# there on day four. Bound to a herdr popup chord, the same way lazygit and
# gh-dash are.
#
# fzf, not television: this script is deliberately self-contained (list,
# preview and naming all have to agree, so they live in one file), which
# removes television's only advantage here — its themed, declarative channel
# config — while fzf's --preview/--height/--bind make it the better primitive
# to embed directly in a script. Called out because a future reader will see
# television everywhere else in this repo and wonder.
#
# Resuming relies on `wt switch` being idempotent where `wt switch --create`
# is not: a plain switch enters an existing worktree, creates one for a
# branch that has none, or creates a tracking worktree for a remote-only
# branch — so an `arocco/<key>/` branch already existing skips naming
# entirely and goes straight through that path.
#
# Worktree creation is delegated whole to `wt`: its own post-switch hook
# (herdr-worktree-workspace) opens and focuses the editor workspace, and
# duplicating that here would double-register it.
#
# The slug comes from the local Claude CLI in headless print mode, using the
# same flag spelling as worktrunk's own commit-message hook (tuned for this
# exact latency profile: ~2.5s/call). Wrapped in a 5s timeout; on timeout or
# any failure it falls back to a deterministic slugification of the summary,
# since the result is presented for editing regardless of where it came from.
#
# `--dry-run` is the test seam: it resolves the full branch name and prints
# the `wt` command that would run, without side effects, so query handling,
# slug generation/fallback, existing-branch matching and name assembly can
# all be exercised by stubbing jira/claude/wt earlier on PATH.
#
# Requires the herdr environment marker, like herdr-workspace-setup: a script
# on PATH can't change its parent shell's directory, so landing in the
# worktree only works through worktrunk's own post-switch hook, which is
# herdr-only.

set -euo pipefail

die() {
  echo "jira-worktree-start: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: jira-worktree-start [--dry-run] [ISSUE-KEY]

With no ISSUE-KEY, opens a picker of Jira issues assigned to you. With one,
skips straight to naming (or resuming, if a worktree already exists for it).

  --dry-run   Resolve and print the branch name/command, without side effects
EOF
}

dry_run=false
issue_key=""
for arg in "$@"; do
  case $arg in
    --dry-run) dry_run=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*) die "unknown option: $arg (see --help)" ;;
    *)
      [[ -n $issue_key ]] \
        && die "only one issue key may be given (got '$issue_key' and '$arg')"
      issue_key=$arg
      ;;
  esac
done

# ── Preconditions ────────────────────────────────────────────────────────────

git rev-parse --show-toplevel >/dev/null 2>&1 \
  || die "not inside a git repository"

[[ -z ${HERDR_ENV:-} ]] && die "not running inside herdr"

# Popup/plugin-launched commands run as a raw command, not through the
# interactive shell, so mise's fish-hook env injection (this repo's own
# JIRA_PROJECT/JIRA_API_TOKEN mechanism) never fires on its own. Load this
# repo's mise env explicitly rather than depending on the caller's shell
# having already activated it.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s bash 2>/dev/null)" || true
fi

command -v jira >/dev/null 2>&1 \
  || die "jira-cli not found on PATH (install jira-cli, ankitpokhrel)"

command -v wt >/dev/null 2>&1 \
  || die "wt (worktrunk) not found on PATH"

[[ -n ${JIRA_PROJECT:-} ]] \
  || die "JIRA_PROJECT not set for this repo"

jira_config_file=${JIRA_CONFIG_FILE:-$HOME/.config/.jira/.config.yml}
[[ -f $jira_config_file ]] \
  || die "jira-cli not initialized — run: jira init"

[[ -n ${JIRA_API_TOKEN:-} ]] \
  || die "JIRA_API_TOKEN not set for this repo"

# ── Pick an issue ────────────────────────────────────────────────────────────

if [[ -z $issue_key ]]; then
  command -v fzf >/dev/null 2>&1 \
    || die "fzf not found on PATH (required for the issue picker)"

  # WHERE clause only — no ORDER BY. jira-cli wraps -q in its own
  # project-scoping expression when --project is also given, and an ORDER BY
  # inside that wrapped sub-expression is invalid JQL ("Expecting ',' but got
  # 'ORDER'", confirmed live). Sort with --order-by/--reverse instead, same
  # as this repo's old (dead) television channel did.
  default_jql='assignee = currentUser() AND statusCategory != Done'
  jql=${JIRA_WORKTREE_JQL:-$default_jql}

  rows=$(jira issue list --project "$JIRA_PROJECT" -q "$jql" \
    --order-by updated --reverse \
    --plain --no-headers --columns key,summary,status --delimiter '|') \
    || die "jira issue list failed"

  if [[ -z $rows ]]; then
    echo "No Jira issues assigned to you were found."
    exit 0
  fi

  # Realigned on whitespace (not the '|' delimiter) so fzf's default field
  # splitting hands {1} the bare key, with no --delimiter of its own to keep
  # in sync with jira-cli's.
  list=$(awk -F'|' '{ printf "%-15s %-60s %s\n", $1, $2, $3 }' <<<"$rows")

  selected=$(fzf --height=90% --layout=reverse --border \
    --header 'Jira: pick an issue (Esc to cancel)' \
    --preview 'jira issue view {1} 2>/dev/null' \
    --preview-window=right:60% <<<"$list") || true

  [[ -z $selected ]] && exit 0

  issue_key=$(awk '{ print $1 }' <<<"$selected")
fi

# Enforced before the key reaches the resume-match regex below: an
# unvalidated CLI-supplied key (the picker always yields a real Jira key, but
# a direct `jira-worktree-start <key>` argument might not) would otherwise be
# interpolated straight into a jq regex, letting metacharacters change match
# semantics instead of just failing to match.
[[ $issue_key =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]] \
  || die "invalid issue key: $issue_key (expected PROJECT-123 format)"

issue_key_upper=$(tr '[:lower:]' '[:upper:]' <<<"$issue_key")
issue_key_lower=$(tr '[:upper:]' '[:lower:]' <<<"$issue_key")

# ── Resume an issue already in flight ────────────────────────────────────────

# Staged for latency: a worktree already open, or a local branch without one,
# is a plain local ref — `git for-each-ref` answers that in milliseconds. Only
# when nothing local matches (a colleague's branch, or one pushed from
# another machine) do we pay for `wt list --remotes`, which needs a live look
# at the remote and is measurably slower. Either way, the plain `wt switch`
# below is the one idempotent path in: it enters an existing worktree,
# creates one for a branch that has none, or creates a tracking worktree for
# a remote-only branch.
local_re="^arocco/${issue_key_lower}/"
existing_branch=$(git for-each-ref --format='%(refname:short)' refs/heads/ \
  2>/dev/null | grep -E "$local_re" | head -n1) || true

if [[ -z $existing_branch ]]; then
  # Remote-only rows list as "<remote>/arocco/<key>/<slug>"; the regex
  # matches that form too, and the sed strips the leading remote name back
  # off, so `wt switch` always gets the bare local branch name it expects.
  match_re="(^|/)arocco/${issue_key_lower}/"
  jq_filter='first(.[] | select(.branch != null'
  jq_filter+=' and (.branch | test($re))) | .branch) // empty'
  existing_branch=$(wt list --format json --remotes 2>/dev/null \
    | jq -r --arg re "$match_re" "$jq_filter")
  existing_branch=$(sed -E 's#^.*/(arocco/)#\1#' <<<"$existing_branch")
fi

if [[ -n $existing_branch ]]; then
  if [[ $dry_run == true ]]; then
    echo "$existing_branch"
    echo "Would run: wt switch $existing_branch"
    exit 0
  fi
  exec wt switch "$existing_branch"
fi

# ── Propose a name for a fresh issue ─────────────────────────────────────────

raw_issue=$(jira issue view "$issue_key_upper" --raw) \
  || die "jira issue view failed for $issue_key_upper"
title=$(jq -r '.fields.summary' <<<"$raw_issue")
description=$(jq -c '.fields.description' <<<"$raw_issue" | head -c 4000)

# Few-shot examples carry the register (terse noun-phrase handles) far more
# effectively than adjectives ever could — real slugs already in this repo's
# history, local or remote, deduplicated.
mapfile -t example_slugs < <(
  git for-each-ref --format='%(refname:short)' refs/heads/ refs/remotes/ \
    2>/dev/null \
    | grep -E '^([^/]+/)?arocco/[^/]+/[^/]+$' \
    | sed -E 's#^([^/]+/)?arocco/[^/]+/##' \
    | sort -u \
    | head -6
)

examples_block=""
if ((${#example_slugs[@]} > 0)); then
  examples_block=$'\nReal branch slugs from this project, for register:\n'
  for s in "${example_slugs[@]}"; do
    examples_block+="- $s"$'\n'
  done
fi

prompt=$(cat <<EOF
Generate a short git branch slug for this Jira issue.

Rules:
- 2 to 4 words
- lowercase kebab-case (letters, digits, hyphens only)
- at most 30 characters
- do not include the issue key
- do not start with a ticket-speak verb (e.g. "fix", "add", "implement")
- output only the slug, nothing else
$examples_block
Issue summary: $title

Issue description (raw JSON, may be Atlassian Document Format):
$description
EOF
)

fallback_slug() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -d- -f1-4 \
    | cut -c1-30 \
    | sed -E 's/-+$//'
}

slug=""
if command -v claude >/dev/null 2>&1; then
  model_out=$(printf '%s' "$prompt" | timeout 5 env MAX_THINKING_TOKENS=0 \
    claude -p --no-session-persistence --model=haiku --tools='' \
    --safe-mode --setting-sources='user' --system-prompt='' 2>/dev/null) \
    || model_out=""
  slug=$(head -n1 <<<"$model_out")
  slug=${slug#"${slug%%[![:space:]]*}"}
  slug=${slug%"${slug##*[![:space:]]}"}
  slug=${slug//\"/}
  slug=${slug//\'/}
  slug=$(tr '[:upper:]' '[:lower:]' <<<"$slug")
fi

if ! [[ $slug =~ ^[a-z0-9]+(-[a-z0-9]+){1,3}$ && ${#slug} -le 30 ]]; then
  slug=$(fallback_slug "$title")
fi

proposed="arocco/${issue_key_lower}/${slug}"

if [[ $dry_run == true ]]; then
  echo "$proposed"
  echo "Would run: wt switch --create $proposed --base @"
  exit 0
fi

read -e -i "$proposed" -p "Branch name: " final_name || exit 0
[[ -z $final_name ]] && exit 0

exec wt switch --create "$final_name" --base @
