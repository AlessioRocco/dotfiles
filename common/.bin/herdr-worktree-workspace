#!/bin/bash
#
# Open a git worktree as a herdr workspace, grouped under its repo. Called
# by git-worktree-setup for every new worktree, whichever tool created it.
#
#   open [--focus] <worktree_path> [branch] [pr_number]
#
# Focus is the caller's call and defaults to off: the hook can't tell an
# agent or a background watcher creating a worktree from a person doing
# it, and stealing focus mid-task is worse than a workspace you have to
# click. Every herdr call is best-effort and the exit status is always 0.

set -uo pipefail

usage() {
  echo "usage: ${0##*/} open [--focus] <worktree_path> [branch] [pr_number]" >&2
  exit 2
}

[[ ${1:-} == open ]] || usage
shift
focus=--no-focus
[[ ${1:-} == --focus ]] && { focus=--focus; shift; }
(($# >= 1)) || usage
wtpath=$1
branch=${2:-}
pr=${3:-}

# Git hooks fire everywhere: plain terminals, ssh sessions and CI
# included. Everywhere but herdr this is a no-op.
[[ -z ${HERDR_ENV:-} ]] && exit 0

herdr=${HERDR_BIN_PATH:-herdr}

# `worktree open` has to be addressed to the repo's ROOT workspace: from
# inside a linked worktree, $HERDR_WORKSPACE_ID is that worktree's own
# workspace and herdr rejects it with `linked_worktree_source`. herdr
# resolves the root from any checkout path in the repo; when it can't, the
# repo simply isn't open in herdr and there is nothing to attach to.
root_ws=$("$herdr" worktree list --cwd "$wtpath" --json 2>/dev/null \
  | jq -r '.result.source.source_workspace_id // empty')
[[ -z $root_ws ]] && exit 0

# A PR worktree carries its number too, so the sidebar entry can be
# matched to the PR by eye.
label=${branch:-${wtpath##*/}}
[[ -n $pr ]] && label="pr-$pr · $label"

command -v zoxide >/dev/null && zoxide add "$wtpath"

# --path and --branch are mutually exclusive; the path is what identifies
# this checkout, and the label is what carries the branch. Already-open
# checkouts come back `already_open`, so a second open is harmless.
"$herdr" worktree open --workspace "$root_ws" --path "$wtpath" \
  --label "$label" "$focus" --json >/dev/null

exit 0
