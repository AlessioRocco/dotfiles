#!/bin/bash
#
# Pick a Jira issue assigned to me and land in a worktree for it — creating
# one, named `arocco/<key>/<slug>`, on day one, or resuming the one already
# there on day four. Bound to a herdr popup chord, the same way lazygit and
# gh-dash are.
#
# fzf, not television: the picker is deliberately embedded in this script
# (the list's columns and the key extraction have to agree, so they live in
# one file), which removes television's only advantage here — its themed,
# declarative channel config — while fzf's --height/--bind make it the
# better primitive to embed directly in a script. Called out because a
# future reader will see television everywhere else in this repo and
# wonder.
#
# Resuming and starting go through the same open-or-create: `herdr worktree
# open --branch` lands in the branch's worktree when it has one, and only a
# `worktree_not_found` answer falls through to `herdr worktree create`. So an
# `arocco/<key>/` branch already existing skips naming entirely. herdr
# places new worktrees under its worktrees.directory and focuses the
# workspace; git-worktree-setup prepares the checkout.
#
# Naming — existing-branch matching and slug generation — lives in
# jira-branch-name, shared with jira-start-watch: the two must agree on what
# an issue's branch is called, or neither can find the other's work. The
# proposed name is presented for editing regardless of where its slug came
# from (model or deterministic fallback).
#
# `--dry-run` is the test seam: it resolves the full branch name and prints
# the herdr commands that would run, without side effects, so query
# handling, slug generation/fallback, existing-branch matching and name
# assembly (jira-branch-name included) can all be exercised by stubbing
# acli/claude/herdr earlier on PATH.
#
# Requires the herdr environment marker, like herdr-workspace-setup: a script
# on PATH can't change its parent shell's directory, so landing in the
# worktree only works by focusing its herdr workspace.

set -euo pipefail

die() {
  echo "jira-worktree-start: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: jira-worktree-start [--dry-run] [ISSUE-KEY]

With no ISSUE-KEY, opens a picker of Jira issues assigned to you. With one,
skips straight to naming (or resuming, if a worktree already exists for it).

  --dry-run   Resolve and print the branch name/command, without side effects
EOF
}

dry_run=false
issue_key=""
for arg in "$@"; do
  case $arg in
    --dry-run) dry_run=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*) die "unknown option: $arg (see --help)" ;;
    *)
      [[ -n $issue_key ]] \
        && die "only one issue key may be given (got '$issue_key' and '$arg')"
      issue_key=$arg
      ;;
  esac
done

# ── Preconditions ────────────────────────────────────────────────────────────

git rev-parse --show-toplevel >/dev/null 2>&1 \
  || die "not inside a git repository"

[[ -z ${HERDR_ENV:-} ]] && die "not running inside herdr"

# Popup/plugin-launched commands run as a raw command, not through the
# interactive shell, so mise's fish-hook env injection (this repo's own
# JIRA_PROJECT mechanism) never fires on its own. Load this repo's mise env
# explicitly rather than depending on the caller's shell having already
# activated it.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s bash 2>/dev/null)" || true
fi

command -v acli >/dev/null 2>&1 \
  || die "acli not found on PATH (install acli, Atlassian CLI)"

command -v herdr >/dev/null 2>&1 \
  || die "herdr not found on PATH"

[[ -n ${JIRA_PROJECT:-} ]] \
  || die "JIRA_PROJECT not set for this repo"

# ── Pick an issue ────────────────────────────────────────────────────────────

if [[ -z $issue_key ]]; then
  command -v fzf >/dev/null 2>&1 \
    || die "fzf not found on PATH (required for the issue picker)"

  # WHERE clause only — no ORDER BY. acli has no --project flag, so the
  # clause is wrapped in parentheses after the project scoping, and an ORDER
  # BY inside that sub-expression is invalid JQL. The sort is appended here
  # instead: least recently updated first, so the most recent sit at the
  # bottom of the list.
  default_jql='assignee = currentUser() AND statusCategory != Done'
  where=${JIRA_WORKTREE_JQL:-$default_jql}
  jql="project = \"$JIRA_PROJECT\" AND ($where) ORDER BY updated ASC"

  json=$(acli jira workitem search --jql "$jql" \
    --fields key,summary,status,labels --json --paginate) \
    || die "acli workitem search failed (logged out? acli jira auth login)"

  # Flattened to key|status|labels|summary rows, one line each. Summary goes
  # last, being the only column whose width varies widely. An empty column
  # becomes "-": column(1) would otherwise collapse it and shift the rest.
  rows=$(jq -r '.[] | [.key, (.fields.status.name // ""),
      ((.fields.labels // []) | join(",")), (.fields.summary // "")]
    | map(gsub("[\n|]"; " ") | if . == "" then "-" else . end)
    | join("|")' <<<"$json") \
    || die "unexpected acli output"

  if [[ -z $rows ]]; then
    echo "No Jira issues assigned to you were found."
    exit 0
  fi

  # Aligned on whitespace (not the '|' delimiter), each column as wide as
  # its longest entry, so the bare key stays the first word of a line.
  list=$(column -t -s'|' <<<"$rows")

  selected=$(fzf --height=90% --layout=reverse --border \
    --header 'Jira: pick an issue (Esc to cancel)' <<<"$list") || true

  [[ -z $selected ]] && exit 0

  issue_key=$(awk '{ print $1 }' <<<"$selected")
fi

# Enforced before the key reaches the resume-match regex below: an
# unvalidated CLI-supplied key (the picker always yields a real Jira key, but
# a direct `jira-worktree-start <key>` argument might not) would otherwise be
# interpolated straight into a jq regex, letting metacharacters change match
# semantics instead of just failing to match.
[[ $issue_key =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]] \
  || die "invalid issue key: $issue_key (expected PROJECT-123 format)"

# ── Resume an issue already in flight ────────────────────────────────────────

# Naming lives in jira-branch-name, shared with jira-start-watch so both
# agree on what an issue's branch is called. Resolved next to this script's
# real path, not via PATH, so it works from the repo and from the stowed
# symlink alike.
branch_name="$(dirname "$(readlink -f "$0")")/jira-branch-name"

# herdr only accepts the primary worktree as the source of an open or a
# create: from a linked one it answers `linked_worktree_source`. The first
# entry of `git worktree list` is always the primary.
repo=$(git worktree list --porcelain | sed -n '1s/^worktree //p')

# Open the branch's worktree, focused, or create it when there is none.
# Detection goes by herdr's JSON error code, not its exit status.
open_or_create() {
  local branch=$1 base=$2 out
  local -a create=(herdr worktree create --cwd "$repo" --branch "$branch")
  [[ -n $base ]] && create+=(--base "$base")
  create+=(--focus)

  if [[ $dry_run == true ]]; then
    echo "$branch"
    echo "Would run: herdr worktree open --cwd $repo --branch $branch --focus"
    echo "  or, with no worktree: ${create[*]}"
    exit 0
  fi

  out=$(herdr worktree open --cwd "$repo" --branch "$branch" --focus 2>&1) \
    && exit 0
  if [[ $(jq -r '.error.code? // empty' <<<"$out" 2>/dev/null) \
    == worktree_not_found ]]; then
    out=$("${create[@]}" 2>&1) && exit 0
  fi
  die "$out"
}

existing_branch=$("$branch_name" existing "$issue_key") || exit 1

if [[ -n $existing_branch ]]; then
  # Remote-only: base it on the remote ref, so the new local branch tracks
  # it. A local branch needs no base.
  base=""
  git show-ref --verify --quiet "refs/heads/$existing_branch" \
    || base=$(git for-each-ref --format='%(refname:short)' \
      "refs/remotes/*/$existing_branch" | head -n1)
  open_or_create "$existing_branch" "$base"
fi

# ── Propose a name for a fresh issue ─────────────────────────────────────────

proposed=$("$branch_name" propose "$issue_key") || exit 1

# Based on this checkout's HEAD, resolved here rather than left to herdr,
# which may resolve it against the repo's primary checkout.
head=$(git rev-parse HEAD)

[[ $dry_run == true ]] && open_or_create "$proposed" "$head"

read -e -i "$proposed" -p "Branch name: " final_name || exit 0
[[ -z $final_name ]] && exit 0

open_or_create "$final_name" "$head"
